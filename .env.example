# Copy to apps/web/.env.local and fill in. Never commit real values.

# Public URL of the web app (used for payment return URLs)
APP_URL=http://localhost:3000

# Platform commission charged to providers on each appointment (percent)
PLATFORM_COMMISSION_PERCENT=10

# JazzCash (https://sandbox.jazzcash.com.pk)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENDPOINT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# Easypaisa
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENDPOINT=https://easypaystg.easypaisa.com.pk/easypay/Index.jsf

# PayFast (Pakistan)
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_TOKEN_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
PAYFAST_CHECKOUT_URL=https://ipguat.apps.net.pk/Ecommerce/api/Transaction/PostTransaction

# AI agent (server-side only)
ANTHROPIC_API_KEY=
