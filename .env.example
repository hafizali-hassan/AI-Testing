# Copy to apps/web/.env.local and fill in. Never commit real values.

# Public URL of the web app (used for payment and email links)
APP_URL=http://localhost:3000

# Platform commission on each invoice, in basis points (1500 = 15%)
PLATFORM_COMMISSION_BPS=1500

# Supabase (database + auth). The publishable key is public; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe (payments, USD)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email: invoices, booking updates)
RESEND_API_KEY=
EMAIL_FROM="Bizniss <no-reply@example.com>"

# AI agent (server-side only)
ANTHROPIC_API_KEY=
