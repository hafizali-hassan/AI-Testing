# Copy to apps/web/.env.local (and the URL lines to apps/marketing/.env.local). Never commit real values.

# Domains: marketing site on the root domain, product on the app subdomain.
# Production example: https://bizniss.pk and https://app.bizniss.pk
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform commission on each invoice, in basis points (1500 = 15%)
PLATFORM_COMMISSION_BPS=1500

# Supabase (database + auth). The publishable key is public; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe (payments, USD)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend (transactional email: invoices, booking updates)
RESEND_API_KEY=
EMAIL_FROM="Bizniss <no-reply@example.com>"

# AI agent (server-side only)
ANTHROPIC_API_KEY=
