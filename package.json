{
  "name": "bizniss",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@bizniss/web",
    "dev:mobile": "turbo run dev --filter=@bizniss/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.11"
  },
  "engines": {
    "node": ">=22"
  }
}
